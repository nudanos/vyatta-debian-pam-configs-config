# postrm script for vyatta-debian-pam-configs-config
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postrm> `remove'
#        * <postrm> `purge'
#        * <old-postrm> `upgrade' <new-version>
#        * <new-postrm> `failed-upgrade' <old-version>
#        * <new-postrm> `abort-install'
#        * <new-postrm> `abort-install' <old-version>
#        * <new-postrm> `abort-upgrade' <old-version>
#        * <disappearer's-postrm> `disappear' <overwriter>
#          <overwriter-version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

pkg=vyatta-debian-pam-configs-config

case "$1" in
    purge|remove|abort-install|disappear)
	for file in atd cron login sshd; do
	    path=/etc/pam.d/$file
	    if [ "$(dpkg-divert --listpackage "$path")" != "$pkg" ]; then
		continue
	    fi
	    if [ -L "$path" ] && [ "$(readlink "$path")" = "$path.vyatta" ]; then
		rm "$path"
	    fi
	    action=--rename
	    if [ -e "$path" ] || [ -L "$path" ]; then
		action=--no-rename
	    fi
	    dpkg-divert --package "$pkg" --remove "$action" "$path"
	done

	path=/usr/share/pam-configs/auditd
	if [ "$(dpkg-divert --listpackage "$path")" = "$pkg" ]; then
	    action=--rename
	    if [ -e "$path" ] || [ -L "$path" ]; then
		action=--no-rename
	    fi
	    dpkg-divert --package "$pkg" --remove "$action" "$path"
	fi
    ;;

    upgrade|failed-upgrade|abort-upgrade)
    ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
