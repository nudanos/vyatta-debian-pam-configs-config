# preinst script for vyatta-debian-pam-configs-config
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <new-preinst> `install'
#        * <new-preinst> `install' <old-version>
#        * <new-preinst> `upgrade' <old-version>
#        * <old-preinst> `abort-upgrade' <new-version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

pkg=vyatta-debian-pam-configs-config

case "$1" in
    install|upgrade)
	for file in atd cron login sshd; do
	    path=/etc/pam.d/$file
	    owner=$(dpkg-divert --listpackage "$path")
	    if [ -z "$owner" ] && [ ! -L "$path" ] && [ ! -e "$path.debian" ] && [ ! -L "$path.debian" ]; then
		dpkg-divert --package "$pkg" --add --rename \
		    --divert "$path.debian" "$path"
		owner=$pkg
	    fi
	    if [ "$owner" = "$pkg" ] && [ ! -e "$path" ] && [ ! -L "$path" ]; then
		ln -s "$path.vyatta" "$path"
	    fi
	done
    ;;

    abort-upgrade)
    ;;

    *)
        echo "preinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
